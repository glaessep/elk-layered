#!/bin/bash
# Refuses to push a branch that is not named <type>/<issue>-<words>.
#
# Git writes the refs it is about to send on stdin, one line each:
# `<local ref> <local oid> <remote ref> <remote oid>`. Only branches are checked: a delete and a
# tag pass. `scripts/check-branch-name.sh` holds the rule. `git push --no-verify` skips the hook.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
checker="$here/../scripts/check-branch-name.sh"
failed=0

while read -r _local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  if [[ "$local_oid" =~ ^0+$ ]]; then
    continue # a delete
  fi
  tip=""
  if ! [[ "$remote_oid" =~ ^0+$ ]]; then
    tip="$remote_oid"
  fi
  bash "$checker" "${remote_ref#refs/heads/}" "$tip" || failed=1
done

exit "$failed"
